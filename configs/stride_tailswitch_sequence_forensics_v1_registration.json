  },
  "sequence_metrics": {
    "adjacent_agent_jaccard": "jaccard(A_t,A_t-1)",
    "recent_three_reuse_fraction": "abs(A_t intersect union(A_t-3..A_t-1))/abs(A_t)",
    "exact_candidate_repeat": "selected_candidate_id occurred in one of the previous three actions",
    "conflict_touch_coverage": "fraction of pre-action conflict edges with at least one selected endpoint",
    "conflict_full_coverage": "fraction of pre-action conflict edges with both endpoints selected",
    "selected_conflict_agent_fraction": "fraction of selected agents incident to a pre-action conflict edge",
    "unresolved_edge_fraction": "abs(E_before intersect E_after)/abs(E_before)",
    "new_edge_fraction": "abs(E_after minus E_before)/abs(E_after)",
    "normalized_conflict_progress": "(conflicts_before-conflicts_after)/max(conflicts_before,1)",
    "largest_component_persistence": "largest_conflict_component_after/max(largest_conflict_component_before,1)"
  },
  "registered_comparisons": {
    "continuation_after_v2": "v2-then-struct minus v2-then-v2",
    "continuation_after_struct": "struct-then-struct minus struct-then-v2",
    "actual_structural_vs_base_actions": "within augmented-policy continuation transitions, grouped by map, challenger and conflict band",
    "adverse_vs_non_adverse_sequences": "registered TailSwitch adverse continuation pairs versus all remaining pairs, with every state retained"
  },
  "interpretation_rules": {
    "candidate_targeting_problem": {
      "required_directions": [
        "structural conflict_touch_coverage is lower",
        "structural normalized_conflict_progress is lower",
        "structural unresolved_edge_fraction is higher"
      ],
      "minimum_challenger_coverage": 2,
      "minimum_map_coverage": 2,
      "causal_wording_allowed": false
    },
    "selection_memory_problem": {
      "required_directions": [
        "adverse continuation pairs have higher recent_three_reuse_fraction",
        "adverse continuation pairs have higher exact_candidate_repeat rate",
        "adverse continuation pairs have higher unresolved_edge_fraction"
      ],
      "minimum_direction_count": 2,
      "causal_wording_allowed": false
    },
    "missing_exit_or_abstention_problem": {
      "required_evidence": [
        "TailSwitch first structural action is not adverse on average",
        "continued augmented selection is adverse on average",
        "adverse pairs contain repeated post-first structural selections before censoring or completion"
      ],
      "causal_scope": "policy-level only"
    }
  },
  "claim_boundary": {
