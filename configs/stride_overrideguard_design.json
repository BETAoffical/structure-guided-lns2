{
  "schema": "lns2.stride.overrideguard_design.v1",
  "scientific_status": "preregistered_after_certguard_rejection_before_action_label_build",
  "design_id": "stride-overrideguard-design-v1",
  "controller_id": "stride-overrideguard-v1",
  "label_artifact_id": "stride-overrideguard-labels-v1",
  "formal_speed_claim": false,
  "default_replacement_allowed": false,
  "architecture": {
    "anchor": "frozen-v2-full",
    "candidate_pool": "frozen-maprank-base-plus-optional-topology-boundary",
    "proposal_direction": "frozen-maprank-direction-and-thresholds",
    "safety_model": "independent-action-conditioned-current-step-classifier",
    "decision_rule": "retain_maprank_override_only_if_action_safety_gate_passes",
    "safety_role": "abstention_only",
    "pair_representation": "oriented_candidate_minus_anchor_plus_pair_mean",
    "base_feature_dimension": 124,
    "action_input_dimension": 248
  },
  "label_design": {
    "schema": "lns2.stride.override_safety_label.v1",
    "unit": "candidate_action_against_frozen_v2_anchor_within_state",
    "positive": "candidate_is_registered_robust_winner_against_anchor",
    "negative": "pair_is_uncertain_or_anchor_is_registered_robust_winner",
    "score": "current_step_conflict_reduction_normalized_by_before_conflicts",
    "source_rule": "same_16_paired_pp_seed_75_percent_0.02_two_half_rule",
    "candidate_actions": "all_non_anchor_candidates",
    "sample_weighting": "equal_total_weight_per_state",
    "runtime_used_in_label": false,
    "future_trajectory_used_in_label": false
  },
  "evaluation_order": [
    "nested_train_map_oof",
    "legacy_validation_descriptive",
    "runtime_semantic_equivalence",
    "legacy_shadow",
    "paired_high_load_development_raw_ttf",
    "paired_fresh_map_raw_ttf_only_after_development_pass"
  ],
  "high_load_role": "post_hoc_development_only_because_it_motivated_the_architecture",
  "fresh_map_role": "first_unseen_end_to_end_evidence",
  "performance_environment_policy": {
    "power_state_source": "user_reported",
    "wall_clock_allowed_only_after_user_reports_comparable_performance_state": true,
    "additional_performance_preflight_required": false,
    "same_reported_power_state_all_comparators_rerun_required": true,
    "pool_timing_across_unmatched_power_states": false,
    "slow_charger_action": "allow_non_timing_work_only"
  },
  "forbidden_inputs": [
    "repair_runtime",
    "time_to_feasible",
    "future_repair_rounds",
    "cost_to_go",
    "receding_q",
    "controller_outcome",
    "high_load_labels_for_training_or_threshold_calibration",
    "legacy_validation_labels_for_threshold_calibration",
    "test_data",
    "formal_ood_data"
  ]
}
